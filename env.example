# Copy to .env and fill in. Avoid '$' in values (docker compose treats it as a variable).
# Generate with: openssl rand -hex 32
SECRET=replace-with-a-long-random-string
# Password for the 'admin' account (min. 10 chars). Changing it here and restarting changes the admin password.
ADMIN_PASSWORD=replace-with-a-strong-password
# 1 = session cookie only over https (right for the tunnel). Use 0 only for plain-http access.
COOKIE_SECURE=1
